     "amount": 845.0,
     "date": "2024-06-14"
    }
   },
   {
    "op": "add",
    "feed": "payments",
    "as": "payment",
    "fields": {
     "payment_doc": "C12-PAY",
     "check_number": "990012",
     "payment_type": "Paper",
     "total": 845.0,
     "issue_date": "2024-06-14",
