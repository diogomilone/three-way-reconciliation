[
 {
  "id": "C01",
  "dataset": "county",
  "title": "Bank debits the same check twice",
  "correct": "flag",
  "why": "A second debit for the same check takes money twice for one payment.",
  "ops": [
   {
    "op": "pick",
    "as": "debit",
    "feed": "bank_lines",
    "where": {
     "amount": {
      "min": 100,
      "max": 10000
     }
    },
    "nth": 4
   },
   {
    "op": "copy",
    "of": "debit",
    "as": "second_debit",
    "set": {},
    "shift_days": 1
   }
  ]
 },
 {
  "id": "C02",
  "dataset": "county",
  "title": "Paid debit missing from the bank feed",
  "correct": "flag",
