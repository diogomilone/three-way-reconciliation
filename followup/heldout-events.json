 {
  "id": "P12",
  "dataset": "processor",
  "title": "Customer receives a partial refund after settlement",
  "correct": "explain",
  "why": "The $100 sale, $3.20 processing fee and subsequent $25 partial refund are fully supported across the feeds.",
  "ops": [
   {
    "op": "add",
    "feed": "ledger_items",
    "as": "booked_charge",
    "fields": {
     "item_id": "P12-LCH",
     "charge_id": "P12-ORDER",
     "kind": "charge",
     "currency": "USD",
     "amount": 100.0,
     "date": "2025-01-15"
    }
   },
   {
    "op": "add",
    "feed": "settlement_rows",
    "as": "settled_charge",
    "fields": {
     "row_id": "P12-SCH",
     "charge_id": "P12-ORDER",
     "kind": "charge",
     "currency": "USD",
     "amount": 100.0,
     "batch": 11,
     "date": "2025-01-16"
    }
   },
   {
    "op": "add",
    "feed": "settlement_rows",
    "as": "fee",
    "fields": {
     "row_id": "P12-SFE",
     "charge_id": "P12-ORDER",
     "kind": "fee",
     "currency": "USD",
     "amount": 3.2,
     "batch": 11,
     "date": "2025-01-16"
    }
   },
   {
    "op": "add",
    "feed": "ledger_items",
    "as": "booked_refund",
    "fields": {
     "item_id": "P12-LRE",
     "charge_id": "P12-ORDER",
     "kind": "refund",
     "currency": "USD",
     "amount": 25.0,
     "date": "2025-01-16"
    }
   },
   {
    "op": "add",
    "feed": "settlement_rows",
    "as": "settled_refund",
    "fields": {
     "row_id": "P12-SRE",
     "charge_id": "P12-ORDER",
     "kind": "refund",
     "currency": "USD",
     "amount": 25.0,
     "batch": 12,
     "date": "2025-01-17"
    }
   },
   {
    "op": "repay"
   }
  ]
 }
