    }
   }
  ]
 },
 {
  "id": "P01",
  "dataset": "processor",
  "title": "Processor omits a booked charge",
  "correct": "flag",
  "why": "The booked sale never settles, and the processor pays out less even though its report and bank agree.",
  "ops": [
   {
    "op": "pick",
    "as": "charge",
    "feed": "settlement_rows",
    "where": {
     "kind": "charge",
     "currency": "USD",
     "amount": {
      "min": 9,
      "max": 100
     }
    },
    "nth": 3
   },
   {
    "op": "remove",
    "on": "charge"
   },
   {
    "op": "repay"
   }
  ]
 },
