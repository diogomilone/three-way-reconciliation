 {
  "id": "C11",
  "dataset": "county",
  "title": "Supplier credit netted into one check",
  "correct": "explain",
  "why": "The $1,250 invoice and $150 credit correctly produce one $1,100 payment and bank debit.",
  "ops": [
   {
    "op": "add",
    "feed": "ledger_lines",
    "as": "invoice",
    "fields": {
     "line_id": "C11-L1",
     "payment_doc": "C11-PAY",
     "vendor": "C11-VENDOR",
     "invoice": "INV-1250",
     "amount": 1250.0,
     "date": "2024-06-14"
    }
   },
   {
    "op": "add",
    "feed": "ledger_lines",
    "as": "credit",
    "fields": {
     "line_id": "C11-L2",
     "payment_doc": "C11-PAY",
     "vendor": "C11-VENDOR",
     "invoice": "CREDIT-150",
     "amount": -150.0,
     "date": "2024-06-14"
    }
   },
   {
    "op": "add",
    "feed": "payments",
    "as": "payment",
    "fields": {
     "payment_doc": "C11-PAY",
     "check_number": "990011",
     "payment_type": "Paper",
     "total": 1100.0,
     "issue_date": "2024-06-14",
     "status": "Paid"
    }
   },
   {
    "op": "add",
    "feed": "bank_lines",
    "as": "debit",
    "fields": {
     "bank_line_id": "C11-BANK",
     "reference": "990011",
     "amount": 1100.0,
     "date": "2024-06-18"
    }
   }
  ]
 },
 {
