 {
  "id": "C08",
  "dataset": "county",
  "title": "Supplier holds a paper check longer",
  "correct": "explain",
  "why": "A paper check clearing several weeks later is ordinary presentation timing and eventually closes.",
  "ops": [
   {
    "op": "pick",
    "as": "debit",
    "feed": "bank_lines",
    "where": {
     "reference": {
      "min": 560000,
      "max": 580000
     },
     "date": {
      "min": "2024-04-01",
      "max": "2024-10-31"
     }
    },
    "nth": 4
   },
   {
    "op": "shift",
    "on": "debit",
    "days": 20
   }
  ]
 },
